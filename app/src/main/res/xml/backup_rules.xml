<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude SQLCipher database files and SQLite journals -->
    <exclude domain="database" path="shellguard_totp.db" />
    <exclude domain="database" path="shellguard_totp.db-wal" />
    <exclude domain="database" path="shellguard_totp.db-shm" />
    <exclude domain="database" path="." />

    <!-- Exclude EncryptedSharedPreferences and Master Key artifacts -->
    <exclude domain="sharedpref" path="shellguard_totp_prefs.xml" />
    <exclude domain="sharedpref" path="device_vault.xml" />
    <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__" />
    <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_file_pref__" />
</full-backup-content>
