<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude SQLCipher database files and journals from cloud backup -->
        <exclude domain="database" path="shellguard_totp.db" />
        <exclude domain="database" path="shellguard_totp.db-wal" />
        <exclude domain="database" path="shellguard_totp.db-shm" />
        <exclude domain="database" path="." />

        <!-- Exclude EncryptedSharedPreferences from cloud backup -->
        <exclude domain="sharedpref" path="shellguard_totp_prefs.xml" />
        <exclude domain="sharedpref" path="device_vault.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_file_pref__" />
    </cloud-backup>
    <device-transfer>
        <!-- Allow device-to-device encrypted migration during phone setup if needed -->
        <include domain="database" path="shellguard_totp.db" />
        <include domain="sharedpref" path="shellguard_totp_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
